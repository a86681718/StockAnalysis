FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV STOCKANALYSIS_ROOT=/app
ENV TPEX_LOCAL_OUTPUT_DIR=/app/outputs/tpex_bs_report
WORKDIR /app

RUN apt-get update && apt-get install -y \
    wget unzip ca-certificates \
    libnss3 libatk-bridge2.0-0 libx11-xcb1 libxcomposite1 \
    libxdamage1 libxrandr2 libasound2 libxshmfence1 libgtk-3-0 \
    libgbm1 libdrm2 xvfb fonts-noto-cjk fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

RUN if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
        wget -q https://edgedl.me.gvt1.com/edgedl/chrome/chrome-for-testing/136.0.7103.113/linux64/chrome-linux64.zip && \
        unzip -q chrome-linux64.zip && \
        mv chrome-linux64 /opt/chrome && \
        ln -s /opt/chrome/chrome /usr/bin/google-chrome && \
        rm chrome-linux64.zip; \
    else \
        apt-get update && \
        apt-get install -y chromium && \
        ln -s /usr/bin/chromium /usr/bin/google-chrome && \
        rm -rf /var/lib/apt/lists/*; \
    fi

COPY apps/tpex/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY src/ /app/src/
COPY apps/tpex/entrypoint-local-runner.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && mkdir -p /app/outputs/tpex_bs_report

ENTRYPOINT ["/app/entrypoint.sh"]
