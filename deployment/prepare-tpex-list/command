REGION="${REGION:-asia-east1}"
PROJECT_NUMBER=$(gcloud projects describe "$PROJECT_ID" --format='get(projectNumber)')
SERVICE_SOURCE=$(python3 ./scripts/stage_cloud_run_source.py prepare-tpex-list)
gcloud run deploy prepare-tpex-list \
  --source "$SERVICE_SOURCE" \
  --region "${REGION}" \
  --memory 512Mi \
  --cpu 1 \
  --concurrency 80 \
  --timeout 3600 \
  --min-instances 1 \
  --max-instances 10 \
   --set-env-vars "QUEUE_NAME=tpex-crawl-queue,FUNCTION_URL=https://trigger-tpex-job-$PROJECT_NUMBER.${REGION}.run.app,LOCATION=${REGION}" \
  --ingress all \
  --cpu-boost \
  --quiet
