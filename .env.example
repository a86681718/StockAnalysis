# Local path overrides
STOCKANALYSIS_ROOT=/path/to/StockAnalysis
STOCKANALYSIS_DATA_DIR=/path/to/stockanalysis-data
STOCKANALYSIS_OUTPUT_DIR=/path/to/stockanalysis-outputs
STOCKANALYSIS_ASSETS_DIR=/path/to/stockanalysis-assets
STOCKANALYSIS_CONF_DIR=/path/to/stockanalysis-conf

# GCP runtime examples
LOCATION=asia-east1
QUEUE_NAME=twse-crawl-queue
FUNCTION_URL=https://trigger-twse-job-<project-number>.asia-east1.run.app
JOB_NAME=twse-crawler
STOCK_CRAWLER_BUCKET=stock-crawler-bucket-YYYYMMDD
